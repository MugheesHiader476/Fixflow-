# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/myenev/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.coverage
/.pytest_cache/
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/
/.local/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated document organization and ingestion output
/doc/data/
/doc/processed/
/doc/uploads/
/backend/uploads/

# Local documentation corpus is intentionally kept out of the GitHub repo.
/doc/*

# Keep Markdown documentation local, except README files (any capitalization).
*.[Mm][Dd]
![Rr][Ee][Aa][Dd][Mm][Ee].[Mm][Dd]

# Markdown parser fixtures are required by the regression tests.
!/backend/tests/fixtures/pipeline/*.md
