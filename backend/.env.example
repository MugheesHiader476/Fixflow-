FRONTEND_ORIGINS=http://localhost:3000
FIXFLOW_DATA_DIR=../doc
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=fixflow
POSTGRES_USER=fixflow
POSTGRES_PASSWORD=
# Alternatively set DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
INGESTION_BATCH_SIZE=100
INGESTION_WORKERS=2

# Shared server-only gateway token, at least 32 random ASCII characters.
# Set the same value in native .env.local and backend/.env, or root .env for Compose.
FIXFLOW_API_TOKEN=



MAX_EXTRACTED_CHARS=5000000

# Native OCR requires Tesseract, its language data and Poppler (pdftoppm).
PIPELINE__OCR_ENABLED=false
PIPELINE__OCR_LANGUAGE=eng
PIPELINE__PARSER_TIMEOUT_SECONDS=60
PIPELINE__PROCESSING_TIMEOUT_SECONDS=180
PIPELINE__PROCESS_MEMORY_MB=1024
PIPELINE__CACHE_ENABLED=true

# Optional one-call evidence synthesis. These stay backend-only. Both are required;
# no model is chosen automatically. Search/indexing work with both left empty.
EVIDENCE__API_KEY=
EVIDENCE__MODEL=
EVIDENCE__TIMEOUT_SECONDS=12
EVIDENCE__MAX_OUTPUT_TOKENS=800
EVIDENCE__REQUESTS_PER_MINUTE=5
# Free local embeddings (no API key): Ollama serving nomic-embed-text.
# `npm run dev:local` starts a project Ollama on 127.0.0.1:11435; first run: `ollama pull nomic-embed-text`.
EMBEDDINGS__URL=http://127.0.0.1:11435
EMBEDDINGS__MODEL=nomic-embed-text
# Fixed space: 768 dimensions; REVISION is the Ollama weights digest prefix (`ollama show`/`/api/tags`).
EMBEDDINGS__DIMENSIONS=768
EMBEDDINGS__REVISION=0a109f422b47
EMBEDDINGS__TIMEOUT_SECONDS=60
EMBEDDINGS__REQUESTS_PER_MINUTE=120
EMBEDDINGS__MIN_SIMILARITY=0.6
# Newly parsed sources queue embedding jobs; set false to embed only on request.
EMBEDDINGS__AUTO_EMBED=true

# Workspace chat model. Backend only. PROVIDER=groq uses Groq's free tier (key from console.groq.com);
# PROVIDER=xai uses xAI Grok (e.g. grok-4.7). Groq's free qwen/qwen3.8-27b allows ~7K input and 1K output
# tokens/minute, so keep INPUT_TOKEN_LIMIT <= 6000 and MAX_OUTPUT_TOKENS <= 900; rate-limited steps resume.
# openai/gpt-oss-* on Groq often emits malformed forced tool calls (tool_use_failed); prefer Qwen.
GROK__PROVIDER=groq
GROK__API_KEY=
GROK__MODEL=qwen/qwen3.8-27b
GROK__REASONING_EFFORT=low
GROK__MAX_STEPS=12
GROK__TIMEOUT_SECONDS=60
GROK__INPUT_TOKEN_LIMIT=6000
GROK__MAX_OUTPUT_TOKENS=900
GROK__REQUESTS_PER_MINUTE=20
GROK__RUN_TIMEOUT_SECONDS=900

# Shared PostgreSQL quotas; failed password/MFA lockout is configured in Clerk.
SECURITY__READ_REQUESTS_PER_MINUTE=240
SECURITY__WRITE_REQUESTS_PER_MINUTE=60
SECURITY__SENSITIVE_REQUESTS_PER_MINUTE=10
SECURITY__AUTH_FAILURES_PER_MINUTE=10
SECURITY__AUTH_FAILURES_GLOBAL_PER_MINUTE=300
SECURITY__EMAIL_DISPATCHES_PER_HOUR=30
SECURITY__ACTIVE_RUNS_PER_OWNER=2
# Sending remains opt-in. Enable, then reconnect Gmail to grant gmail.send.
CONNECTORS__GMAIL_SEND_ENABLED=false

# Native connectors; Gmail sending is a separate opt-in permission. These are backend-only secrets; never use NEXT_PUBLIC_*.
# Slack requires HTTPS. For local Slack use https://localhost:3000 in both servers;
# Docker's gateway serves local HTTPS automatically when the root setting uses HTTPS.
# npm run dev / dev:local serves TLS automatically with a private development certificate.
CONNECTORS__PUBLIC_URL=http://localhost:3000
# Generate once with cryptography.fernet.Fernet.generate_key(); preserve it across restarts.
CONNECTORS__VAULT_KEY=
# JSON array of former encryption keys during rotation.
CONNECTORS__VAULT_PREVIOUS_KEYS=[]
CONNECTORS__GOOGLE_CLIENT_ID=
CONNECTORS__GOOGLE_CLIENT_SECRET=
CONNECTORS__GITHUB_CLIENT_ID=
CONNECTORS__GITHUB_CLIENT_SECRET=
CONNECTORS__GITHUB_APP_ID=
CONNECTORS__GITHUB_APP_SLUG=
# Quote PEM content; escaped \n sequences are accepted.
CONNECTORS__GITHUB_PRIVATE_KEY=
CONNECTORS__GITHUB_WEBHOOK_SECRET=
CONNECTORS__GITHUB_API_VERSION=2026-03-10
CONNECTORS__SLACK_CLIENT_ID=
CONNECTORS__SLACK_CLIENT_SECRET=
CONNECTORS__SLACK_SIGNING_SECRET=
CONNECTORS__EVENTS_ENABLED=false
CONNECTORS__GMAIL_PUBSUB_TOPIC=
CONNECTORS__GMAIL_PUBSUB_SERVICE_ACCOUNT=
CONNECTORS__POLLING_SECONDS=300
CONNECTORS__RECONCILIATION_SECONDS=86400
CONNECTORS__ACL_TTL_SECONDS=3600
CONNECTORS__SLACK_HISTORY_INTERVAL_SECONDS=60
# Bounded provider requests, durable retry and resource/action limits.
CONNECTORS__REQUEST_TIMEOUT_SECONDS=30
CONNECTORS__MAX_RESPONSE_BYTES=52428800
CONNECTORS__PAGE_SIZE=25
CONNECTORS__MAX_SYNC_RESOURCES=100000
CONNECTORS__MAX_RETRIES=3
CONNECTORS__USER_ACTIONS_PER_MINUTE=30
