FRONTEND_ORIGINS=http://localhost:3000
FIXFLOW_DATA_DIR=../doc
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=fixflow
POSTGRES_USER=fixflow
POSTGRES_PASSWORD=
# Alternatively set DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
# Leave unset until the embedding model/dimension is selected.
EMBEDDING_DIM=
EMBEDDING_MODEL=
INGESTION_BATCH_SIZE=100
INGESTION_WORKERS=2

# Shared server-only gateway token, at least 32 random ASCII characters.
# Set the same value in native .env.local and backend/.env, or root .env for Compose.
FIXFLOW_API_TOKEN=

# Optional embedding POST endpoint; leave unset for keyword retrieval only.

# Local Ollama transport (native backend only; leave empty until winner selection).
# Remote EMBEDDING_API_URL continues to require HTTPS; configure only one transport.
OLLAMA_URL=
EMBEDDING_MODEL_DIGEST=
EMBEDDING_PROFILE=plain-v1
EMBEDDING_WORKERS=1

EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=4
MAX_EXTRACTED_CHARS=5000000
MAX_DOCUMENT_CHUNKS=10000

# Validated ingestion-to-chunks configuration; see docs/ingestion-pipeline.md.
# Native OCR requires Tesseract, its language data and Poppler (pdftoppm).
PIPELINE__OCR_ENABLED=false
PIPELINE__OCR_LANGUAGE=eng
# With utf8_bytes, the maximum includes retrieval context; this is model-neutral.
# Minimum is a merge preference; validated complete short units are retained.
PIPELINE__MAX_CHUNK_TOKENS=1024
PIPELINE__MIN_CHUNK_TOKENS=16
PIPELINE__TOKENIZER=utf8_bytes
PIPELINE__TOKENIZER_ENCODING=
PIPELINE__PARSER_TIMEOUT_SECONDS=60
PIPELINE__PROCESSING_TIMEOUT_SECONDS=180
PIPELINE__PROCESS_MEMORY_MB=1024
PIPELINE__TABLE_ROWS_PER_CHUNK=50
PIPELINE__SEMANTIC_BREAKPOINT=0.15
PIPELINE__CACHE_ENABLED=true

# Optional read-only connectors. These are backend-only secrets; never use NEXT_PUBLIC_*.
CONNECTORS__PUBLIC_URL=http://localhost:3000
# Generate once with cryptography.fernet.Fernet.generate_key(); preserve it across restarts.
CONNECTORS__VAULT_KEY=
# JSON array of former encryption keys during rotation.
CONNECTORS__VAULT_PREVIOUS_KEYS=[]
CONNECTORS__GOOGLE_CLIENT_ID=
CONNECTORS__GOOGLE_CLIENT_SECRET=
CONNECTORS__GITHUB_CLIENT_ID=
CONNECTORS__GITHUB_CLIENT_SECRET=
CONNECTORS__GITHUB_APP_ID=
CONNECTORS__GITHUB_APP_SLUG=
# Quote PEM content; escaped \n sequences are accepted.
CONNECTORS__GITHUB_PRIVATE_KEY=
CONNECTORS__GITHUB_WEBHOOK_SECRET=
CONNECTORS__GITHUB_API_VERSION=2026-03-10
CONNECTORS__SLACK_CLIENT_ID=
CONNECTORS__SLACK_CLIENT_SECRET=
CONNECTORS__SLACK_SIGNING_SECRET=
CONNECTORS__EVENTS_ENABLED=false
CONNECTORS__GMAIL_PUBSUB_TOPIC=
CONNECTORS__GMAIL_PUBSUB_SERVICE_ACCOUNT=
CONNECTORS__POLLING_SECONDS=300
CONNECTORS__RECONCILIATION_SECONDS=86400
CONNECTORS__ACL_TTL_SECONDS=3600
CONNECTORS__SLACK_HISTORY_INTERVAL_SECONDS=60
# Bounded provider requests, durable retry and resource/action limits.
CONNECTORS__REQUEST_TIMEOUT_SECONDS=30
CONNECTORS__MAX_RESPONSE_BYTES=52428800
CONNECTORS__PAGE_SIZE=25
CONNECTORS__MAX_SYNC_RESOURCES=100000
CONNECTORS__MAX_RETRIES=3
CONNECTORS__USER_ACTIONS_PER_MINUTE=30
