FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements.txt ./backend/requirements.txt
COPY requirements-ingestion.txt ./requirements-ingestion.txt
RUN python -m pip install --no-cache-dir -r backend/requirements.txt -r requirements-ingestion.txt
COPY alembic.ini ./
COPY backend ./backend
COPY scripts ./scripts
RUN useradd --uid 10001 --create-home app && mkdir -p /app/data && chown app:app /app/data
USER app
EXPOSE 8000
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
