# Docker Desktop + two native loopback Ollama runtimes. Keep existing root credentials.
# Also copy the pinned model/profile settings from answers.env.example and ollama.env.example.
COMPOSE_FILE=compose.yaml:compose.ollama-host.yaml
OLLAMA_RELAY_IMAGE=nginx@sha256:bf3201ab56f23e5954646379c775d511fc466e9f11376d9725361064ad07ed35
OLLAMA_URL=http://127.0.0.1:11434
GENERATION_OLLAMA_URL=http://127.0.0.1:11435
RETRIEVAL_TIMEOUT_SECONDS=20
GENERATION_TIMEOUT_SECONDS=90
