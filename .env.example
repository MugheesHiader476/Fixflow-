# Docker Compose reads a copied root .env file automatically.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-side Clerk key. Never prefix this with NEXT_PUBLIC_.
CLERK_SECRET_KEY=
POSTGRES_DB=fixflow
POSTGRES_USER=fixflow
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Optional compose.scale.yaml: distinct runtime login; migration owner stays above.
# Use a random 32–128 character URL-safe password. Never reuse the owner password.
POSTGRES_RUNTIME_USER=fixflow_runtime
POSTGRES_RUNTIME_PASSWORD=
FRONTEND_ORIGINS=http://localhost:3000


# Shared server-only gateway token, at least 32 random ASCII characters.
# Set the same value in native .env.local and backend/.env, or root .env for Compose.
FIXFLOW_API_TOKEN=

# Docker includes Tesseract/Poppler; OCR runs only when native/layout parsing fails.
PIPELINE__OCR_ENABLED=true
PIPELINE__PARSER_TIMEOUT_SECONDS=60
# Other validated PipelineConfig fields can be supplied as JSON:
# PIPELINE={"processing_timeout_seconds":180}

# Optional backend-only cited synthesis; leave empty for local evidence search.
EVIDENCE__API_KEY=
EVIDENCE__MODEL=
EVIDENCE__TIMEOUT_SECONDS=12
EVIDENCE__MAX_OUTPUT_TOKENS=800
EVIDENCE__REQUESTS_PER_MINUTE=5
# Optional backend-only Gemini semantic search. No automatic embedding/backfill.
GEMINI__API_KEY=
GEMINI__MODEL=
# Explicit supported model: gemini-embedding-2; supported dimensions: 768.
GEMINI__DIMENSIONS=768
GEMINI__REVISION=gemini-embedding-2
GEMINI__TIMEOUT_SECONDS=12
GEMINI__REQUESTS_PER_MINUTE=5
GEMINI__MIN_SIMILARITY=0.5

# Grok workspace workflows. Backend only; model and key are required.
# Example model: grok-4.7 (verify availability in your xAI account).
GROK__API_KEY=
GROK__MODEL=
GROK__REASONING_EFFORT=low
GROK__MAX_STEPS=12
GROK__TIMEOUT_SECONDS=25
GROK__INPUT_TOKEN_LIMIT=16000
GROK__MAX_OUTPUT_TOKENS=1800
GROK__REQUESTS_PER_MINUTE=10
GROK__RUN_TIMEOUT_SECONDS=600

# Shared PostgreSQL quotas; failed password/MFA lockout is configured in Clerk.
SECURITY__READ_REQUESTS_PER_MINUTE=240
SECURITY__WRITE_REQUESTS_PER_MINUTE=60
SECURITY__SENSITIVE_REQUESTS_PER_MINUTE=10
SECURITY__AUTH_FAILURES_PER_MINUTE=10
SECURITY__AUTH_FAILURES_GLOBAL_PER_MINUTE=300
SECURITY__EMAIL_DISPATCHES_PER_HOUR=30
SECURITY__ACTIVE_RUNS_PER_OWNER=2
# Sending remains opt-in. Enable, then reconnect Gmail to grant gmail.send.
CONNECTORS__GMAIL_SEND_ENABLED=false

# Native connectors; Gmail sending is a separate opt-in permission. These are backend-only secrets; never use NEXT_PUBLIC_*.
CONNECTORS__PUBLIC_URL=http://localhost:3000
# Generate once with cryptography.fernet.Fernet.generate_key(); preserve it across restarts.
CONNECTORS__VAULT_KEY=
# JSON array of former encryption keys during rotation.
CONNECTORS__VAULT_PREVIOUS_KEYS=[]
CONNECTORS__GOOGLE_CLIENT_ID=
CONNECTORS__GOOGLE_CLIENT_SECRET=
CONNECTORS__GITHUB_CLIENT_ID=
CONNECTORS__GITHUB_CLIENT_SECRET=
CONNECTORS__GITHUB_APP_ID=
CONNECTORS__GITHUB_APP_SLUG=
# Quote PEM content; escaped \n sequences are accepted.
CONNECTORS__GITHUB_PRIVATE_KEY=
CONNECTORS__GITHUB_WEBHOOK_SECRET=
CONNECTORS__GITHUB_API_VERSION=2026-03-10
CONNECTORS__SLACK_CLIENT_ID=
CONNECTORS__SLACK_CLIENT_SECRET=
CONNECTORS__SLACK_SIGNING_SECRET=
CONNECTORS__EVENTS_ENABLED=false
CONNECTORS__GMAIL_PUBSUB_TOPIC=
CONNECTORS__GMAIL_PUBSUB_SERVICE_ACCOUNT=
CONNECTORS__POLLING_SECONDS=300
CONNECTORS__RECONCILIATION_SECONDS=86400
CONNECTORS__ACL_TTL_SECONDS=3600
CONNECTORS__SLACK_HISTORY_INTERVAL_SECONDS=60
# Bounded provider requests, durable retry and resource/action limits.
CONNECTORS__REQUEST_TIMEOUT_SECONDS=30
CONNECTORS__MAX_RESPONSE_BYTES=52428800
CONNECTORS__PAGE_SIZE=25
CONNECTORS__MAX_SYNC_RESOURCES=100000
CONNECTORS__MAX_RETRIES=3
CONNECTORS__USER_ACTIONS_PER_MINUTE=30
