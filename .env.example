# Docker Compose reads a copied root .env file automatically.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-side Clerk key. Never prefix this with NEXT_PUBLIC_.
CLERK_SECRET_KEY=
POSTGRES_DB=fixflow
POSTGRES_USER=fixflow
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
FRONTEND_ORIGINS=http://localhost:3000

# Shared server-only gateway token, at least 32 random ASCII characters.
# Set the same value in native .env.local and backend/.env, or root .env for Compose.
FIXFLOW_API_TOKEN=

# Docker includes Tesseract/Poppler; OCR runs only when native/layout parsing fails.
PIPELINE__OCR_ENABLED=true
PIPELINE__MAX_CHUNK_TOKENS=1024
PIPELINE__MIN_CHUNK_TOKENS=16
PIPELINE__TOKENIZER=utf8_bytes
# Set both tokenizer=tiktoken and an explicit encoding after selecting its tokenizer.
PIPELINE__TOKENIZER_ENCODING=
PIPELINE__PARSER_TIMEOUT_SECONDS=60
# Other validated PipelineConfig fields can be supplied as a JSON object, for example:
# PIPELINE={"processing_timeout_seconds":180,"table_rows_per_chunk":50}
